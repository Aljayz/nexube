{
  "name": "@nexube/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "pnpm --filter @nexube/types run build && pnpm --filter @nexube/store run build && vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "pnpm --filter @nexube/types run build && pnpm --filter @nexube/store run build && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@nexube/player-engine": "workspace:*",
    "@nexube/store": "workspace:*",
    "@nexube/types": "workspace:*",
    "@nexube/ui-tokens": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.7.0",
    "electron-store": "^8.1.0",
    "lucide-react": "^1.16.0",
    "m3u8-parser": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.nexube.app",
    "productName": "Nexube",
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      {
        "from": "resources/vid-dl/${os}/${vid-dl}",
        "to": "vid-dl",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/Logo.ico",
      "extraResources": [
        {
          "from": "resources/vid-dl/windows/vid-dl",
          "to": "vid-dl",
          "filter": ["**/*"]
        }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb", "pacman"],
      "icon": "public/Logo.png"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "public/Logo.icns",
      "category": "public.app-category.entertainment"
    }
  }
}
