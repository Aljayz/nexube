{
  "name": "@nexube/desktop",
  "version": "0.2.1",
  "description": "Nexube - Cross-platform media streaming desktop app",
  "author": "Aljayz <albertjaybarororosique@gmail.com>",
  "homepage": "https://github.com/Aljayz/nexube",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "pnpm --filter @nexube/types run build && pnpm --filter @nexube/store run build && vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --no-sandbox\"",
    "electron:build": "vite build && electron-builder --publish=never",
    "build:downloader": "python ../desk-vid-dl/build.py"
  },
  "dependencies": {
    "@nexube/player-engine": "workspace:*",
    "@nexube/store": "workspace:*",
    "@nexube/types": "workspace:*",
    "@nexube/ui-tokens": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.7.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.16.0",
    "m3u8-parser": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.0",
    "prebuild-install": "^7.1.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "cross-env": "^7.0.3",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.nexube.app",
    "productName": "Nexube",
    "directories": {
      "output": "release"
    },
    "electronVersion": "28.3.3",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Aljayz",
      "repo": "nexube",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexube",
      "installerIcon": "public/Logo.ico",
      "uninstallerIcon": "public/Logo.ico",
      "installerHeaderIcon": "public/Logo.ico"
    },
    "win": {
      "target": "nsis",
      "icon": "public/Logo.ico",
      "extraResources": [
        {
          "from": "resources/desk-vid-dl/windows/desk-vid-dl",
          "to": "desk-vid-dl",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/sized",
      "category": "Video",
      "executableArgs": ["--no-sandbox"],
      "desktop": {
        "entry": {
          "Name": "Nexube",
          "Comment": "Nexube - Cross-platform media streaming desktop app",
          "Categories": "AudioVideo;Video;Player;Multimedia;Internet;",
          "Icon": "nexube",
          "StartupWMClass": "Nexube"
        }
      },
      "extraResources": [
        {
          "from": "resources/desk-vid-dl/linux/desk-vid-dl",
          "to": "desk-vid-dl",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  }
}
